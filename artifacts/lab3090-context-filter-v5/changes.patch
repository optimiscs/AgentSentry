+def select_cases(planned, requested):
+    """Keep native order and reject mistyped or duplicate explicit selections."""
+    if not requested:
+        return planned
+    wanted = set(requested)
+    indexed = [("/".join([s, u, i or "benign"]), (s, u, i)) for s, u, i in planned]
+    if len(wanted) != len(requested) or not wanted <= {key for key, _ in indexed}:
+        raise ValueError("INVALID_OR_DUPLICATE_CASE_SELECTION")
+    return [case for key, case in indexed if key in wanted]
+
