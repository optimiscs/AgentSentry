+def word_spans(text: str):
+    # Serialized tool text can contain literal backslash-n/r/t while the model
+    # quotes actual whitespace. Keep every source offset by replacing escape
+    # characters with equal-length blanks; execution data is never decoded here.
+    view = re.sub(r"\\[nrt]", lambda m: " " * len(m.group()), text)
+    return list(re.finditer(r"\w+", view))
+
