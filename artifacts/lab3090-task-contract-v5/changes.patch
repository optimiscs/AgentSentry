+    @staticmethod
+    def _proof_schema(schema, payload):
+        """Constrain syntax to the exact outstanding proofs, not their truth."""
+        requirements = payload["evidence_requirements"]
+        schema["properties"]["step_id"]["enum"] = list(requirements)
+        paths = sorted({p for r in requirements.values() for p in r["arguments"]})
+        schema["properties"]["evidence"]["maxItems"] = min(
+            schema["properties"]["evidence"]["maxItems"], len(paths)
+        )
+        if not paths:
+            return
+        sources = ["user", *sorted({s for r in requirements.values() for s in r["observation_ids"]})]
+        fields = schema["$defs"]["Evidence"]["properties"]
+        fields["argument"]["enum"] = paths
+        schema["$defs"]["SourceRef"]["properties"]["source"]["enum"] = sources
+        schema["$defs"]["SourceRef"]["required"] = ["source"]
+        branches = [
+            {
+                "required": ["source"],
+                "properties": {
+                    "operation": {"const": "value"},
+                    "source": {"enum": sources},
+                    "operands": {"maxItems": 0},
+                },
+            },
+            {
+                "required": ["operation", "operands"],
+                "properties": {
+                    "operation": {"enum": [v for v in fields["operation"]["enum"] if v != "value"]},
+                    "source": {"const": ""},
+                    "pointer": {"const": ""},
+                    "quote": {"const": None},
+                    "operands": {"minItems": 1},
+                },
+            },
+        ]
+        # Put the common object constraints inside every alternative. Some
+        # constrained decoders ignore sibling properties/required beside anyOf.
+        # Complete alternatives preserve argument/source fields during generation;
+        # the post-generation evidence checker still decides whether they are true.
+        base = schema["$defs"]["Evidence"]
+        variants = []
+        for branch in branches:
+            variant = deepcopy(base)
+            variant["required"] = list(dict.fromkeys(base["required"] + branch["required"]))
+            for name, constraint in branch["properties"].items():
+                variant["properties"][name].update(constraint)
+            variants.append(variant)
+        schema["$defs"]["Evidence"] = {"anyOf": variants}
