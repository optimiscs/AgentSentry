+@pytest.mark.case("TC-22")
+def test_asb_execution_score_does_not_replace_native_text_score():
+    baseline, full = runs()
+    for run in [baseline, full]:
+        run["manifest"].update(
+            benchmark="ASB", protocol="local-e5", retrieval_manifest={"hash": "fixed"}
+        )
+        for row in run["rows"].values():
+            row.update(
+                native_text_attack_success=True,
+                native_text_utility=False,
+                all_normal_tools_executed=True,
+            )
+    result = acceptance.compare(baseline, full)
