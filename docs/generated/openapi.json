  "components": {
    "schemas": {
      "ApprovalInput": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "approve": {
            "type": "boolean",
            "title": "Approve"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approval_id",
          "approve"
        ],
        "title": "ApprovalInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NativeCall": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "client": {
            "type": "string",
            "pattern": "^(codex|claude-code)$",
            "title": "Client"
          },
          "client_session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Session Id"
          },
          "tool_call_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Tool Call Id"
          },
          "cwd": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Cwd"
          },
          "tool_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Tool Name"
          },
          "tool_input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tool Input"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "client",
          "client_session_id",
          "tool_call_id",
          "cwd",
          "tool_name"
        ],
        "title": "NativeCall"
      },
      "NativeReport": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "call": {
            "$ref": "#/components/schemas/NativeCall"
          },
          "receipt": {
            "type": "string",
            "maxLength": 256,
            "minLength": 16,
            "title": "Receipt"
          },
          "output": {
            "type": "string",
            "maxLength": 65536,
            "title": "Output"
          },
          "failed": {
            "type": "boolean",
            "title": "Failed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "call",
          "receipt",
          "output"
        ],
        "title": "NativeReport"
      },
      "PolicyInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 65536,
            "title": "Text"
          },
          "expected_version": {
            "type": "string",
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "expected_version"
        ],
        "title": "PolicyInput"
      },
      "ScanBatchInput": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/ScanInput"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Chunks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chunks"
        ],
        "title": "ScanBatchInput"
      },
      "ScanInput": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "source_id": {
            "type": "string",
            "maxLength": 2048,
            "title": "Source Id"
          },
          "text": {
            "type": "string",
            "maxLength": 65536,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "source_type",
          "source_id",
          "text"
        ],
        "title": "ScanInput"
      },
      "SessionInput": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "task": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Task"
          },
          "scope": {
            "type": "string",
            "maxLength": 1024,
            "title": "Scope",
            "default": "."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task"
        ],
        "title": "SessionInput"
      },
      "SourceType": {
        "type": "string",
        "enum": [
          "USER",
          "WEB",
          "DOCUMENT",
          "ISSUE",
          "MCP_DESCRIPTION",
          "MCP_RESPONSE",
          "MEMORY",
          "SUB_AGENT"
        ],
        "title": "SourceType"
      },
      "ToolCall": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "tool": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Tool"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 128,
            "title": "Source Refs"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "tool"
        ],
        "title": "ToolCall"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
